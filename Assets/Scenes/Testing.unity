  m_text: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C
    \u043D\u0430 \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435.\r\n\r\n\u0417\u0434\u0435\u0441\u044C
